            {
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<div class='cursostic-sidebar-filters'>\n  <div class='filter-group' style='margin-bottom: 25px;'>\n    <label style='display: block; font-weight: 600; margin-bottom: 10px; color: #1f2937;'>Categoría</label>\n    <select id='filter-categoria' style='width: 100%; padding: 12px; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 14px;'>\n      <option value=''>Todas las categorías</option>\n      <!-- Se rellenará automáticamente -->\n    </select>\n  </div>\n  \n  <div class='filter-group' style='margin-bottom: 25px;'>\n    <label style='display: block; font-weight: 600; margin-bottom: 10px; color: #1f2937;'>Nivel</label>\n    <select id='filter-nivel' style='width: 100%; padding: 12px; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 14px;'>\n      <option value=''>Todos los niveles</option>\n      <!-- Se rellenará automáticamente -->\n    </select>\n  </div>\n  \n  <div class='filter-group' style='margin-bottom: 25px;'>\n    <label style='display: block; font-weight: 600; margin-bottom: 10px; color: #1f2937;'>Modalidad</label>\n    <select id='filter-modalidad' style='width: 100%; padding: 12px; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 14px;'>\n      <option value=''>Todas las modalidades</option>\n      <!-- Se rellenará automáticamente -->\n    </select>\n  </div>\n  \n  <div class='filter-group' style='margin-bottom: 25px;'>\n    <label style='display: block; font-weight: 600; margin-bottom: 10px; color: #1f2937;'>Precio</label>\n    <select id='filter-precio' style='width: 100%; padding: 12px; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 14px;'>\n      <option value=''>Todos</option>\n      <option value='gratis'>Gratuitos</option>\n      <option value='pago'>De pago</option>\n    </select>\n  </div>\n  \n  <button class='cursostic-btn-apply' style='width: 100%; padding: 14px; background: #2563eb; color: white; border: none; border-radius: 8px; font-weight: 600; cursor: pointer; margin-bottom: 10px;'>Aplicar Filtros</button>\n  \n  <button class='cursostic-btn-reset' style='width: 100%; padding: 14px; background: #f3f4f6; color: #6b7280; border: none; border-radius: 8px; font-weight: 600; cursor: pointer;'>Limpiar Filtros</button>\n</div>"
