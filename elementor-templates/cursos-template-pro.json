                "order": "DESC",
                "columns": 2,
                "columns_tablet": 1,
                "columns_mobile": 1
              }
            },
            {
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<div class='cursostic-pagination' style='margin-top: 40px; text-align: center;'>\n  <!-- La paginación se añadirá automáticamente -->\n</div>"
              }
            }
