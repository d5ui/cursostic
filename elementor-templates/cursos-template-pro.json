                "icon_size": {"unit": "px", "size": 30},
                "box_background_color": "#fffbeb",
                "box_padding": {"unit": "px", "top": 20, "right": 15, "bottom": 20, "left": 15},
                "box_border_radius": {"unit": "px", "top": 8, "right": 8, "bottom": 8, "left": 8},
                "title_color": "#d97706",
                "description_color": "#92400e"
              }
